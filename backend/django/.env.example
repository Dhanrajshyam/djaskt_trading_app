# Copy to .env and fill in real values. Never commit the real .env file.

# Infisical Vault (optional). When INFISICAL_CLIENT_ID/SECRET are set, Django
# sources SECRET_KEY, DB_PASSWORD/REPLICA_DB_PASSWORD, and REDIS_PASSWORD
# from Vault first, falling back to the plain values below if Vault is
# unreachable, unconfigured, or missing a given key. Leave the two below
# blank to skip Vault entirely and use only the fallback values (today's
# behavior).
INFISICAL_URL=http://localhost:8081
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=dev
INFISICAL_SECRET_PATH=/

# Fallback values, used directly if Vault is unconfigured/unreachable/missing a key.
SECRET_KEY=change-me-to-a-random-50-char-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Primary database (system of record — read/write, ACID-critical).
# DB_PASSWORD is Vault-backed (falls back to this value); host/port/name/
# user below are plain config, not secrets.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=djaskt_ledger
DB_USER=djaskt
DB_PASSWORD=djaskt

# Read replica database (reporting/analytics — read-only). Currently points
# at the same physical database as above; once a real replica exists, only
# these values (and the REPLICA_DB_PASSWORD secret in Vault) need to change.
REPLICA_DB_HOST=localhost
REPLICA_DB_PORT=5432
REPLICA_DB_NAME=djaskt_ledger
REPLICA_DB_USER=djaskt
REPLICA_DB_PASSWORD=djaskt

# REDIS_PASSWORD is Vault-backed (falls back to this value, empty meaning
# "no auth"); host/port/db below are plain config, not secrets.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Production-only hardening (leave off for local dev)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
