# Copy to .env.local for local development (Vite auto-loads .env.local and
# never expects it to be committed — see .gitignore).
#
# Vite only exposes env vars prefixed with VITE_ to browser code, as a
# safety rail against accidentally shipping a secret to the client bundle.

# Base URL of the Django REST API (see backend/django/django_app/urls.py —
# mounted at /api/v1/).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Base URL of the Django Channels WebSocket endpoint (see
# backend/django/ledger/realtime/routing.py).
VITE_WS_BASE_URL=ws://localhost:8000
